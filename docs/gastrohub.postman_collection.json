{
  "info": {
    "name": "GastroHub API",
    "_postman_id": "gastrohub-api-collection",
    "description": "FIAP PostTech Tech Challenge Phase 2 — GastroHub API local testing.\n\nOrdem recomendada: UserType → User → Restaurant → MenuItem\n\nOs scripts de Post-response salvam os IDs automaticamente nas variáveis da collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "userTypeId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "restaurantId", "value": "", "type": "string" },
    { "key": "menuItemId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "UserType",
      "item": [
        {
          "name": "POST Criar UserType",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const id = pm.response.json().id;",
                  "  pm.collectionVariables.set('userTypeId', id);",
                  "  console.log('userTypeId salvo:', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/user-types", "host": ["{{baseUrl}}"], "path": ["user-types"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente\",\n  \"baseCategory\": \"CLIENT\"\n}"
            }
          }
        },
        {
          "name": "POST Criar UserType OWNER",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const id = pm.response.json().id;",
                  "  pm.collectionVariables.set('userTypeOwnerId', id);",
                  "  console.log('userTypeOwnerId salvo:', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/user-types", "host": ["{{baseUrl}}"], "path": ["user-types"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Proprietário\",\n  \"baseCategory\": \"OWNER\"\n}"
            }
          }
        },
        {
          "name": "GET Listar UserTypes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/user-types", "host": ["{{baseUrl}}"], "path": ["user-types"] }
          }
        },
        {
          "name": "GET Buscar UserType por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user-types/{{userTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-types", "{{userTypeId}}"]
            }
          }
        },
        {
          "name": "PUT Atualizar UserType",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/user-types/{{userTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-types", "{{userTypeId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente VIP\",\n  \"baseCategory\": \"CLIENT\"\n}"
            }
          }
        },
        {
          "name": "DELETE Remover UserType",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/user-types/{{userTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-types", "{{userTypeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "POST Criar User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const id = pm.response.json().id;",
                  "  pm.collectionVariables.set('userId', id);",
                  "  console.log('userId salvo:', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"password\": \"senha123\",\n  \"userType\": {\n    \"id\": \"{{userTypeOwnerId}}\",\n    \"name\": \"Proprietário\",\n    \"baseCategory\": \"OWNER\"\n  }\n}"
            }
          }
        },
        {
          "name": "GET Listar Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "GET Buscar User por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "GET Buscar User por Nome",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/name/João Silva",
              "host": ["{{baseUrl}}"],
              "path": ["users", "name", "João Silva"]
            }
          }
        },
        {
          "name": "PUT Atualizar User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva Atualizado\",\n  \"email\": \"joao.novo@email.com\",\n  \"password\": \"novaSenha456\",\n  \"userType\": {\n    \"id\": \"{{userTypeOwnerId}}\",\n    \"name\": \"Proprietário\",\n    \"baseCategory\": \"OWNER\"\n  }\n}"
            }
          }
        },
        {
          "name": "DELETE Remover User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Restaurant",
      "item": [
        {
          "name": "POST Criar Restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const id = pm.response.json().id;",
                  "  pm.collectionVariables.set('restaurantId', id);",
                  "  console.log('restaurantId salvo:', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sabor do Brasil\",\n  \"address\": \"Rua das Flores, 123 - São Paulo/SP\",\n  \"kitchenType\": \"BRAZILIAN\",\n  \"openingHours\": \"Seg-Sex 11h-22h\",\n  \"restaurantOwnerId\": \"{{userId}}\"\n}"
            }
          }
        },
        {
          "name": "GET Listar Restaurants",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
          }
        },
        {
          "name": "GET Buscar Restaurant por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}"]
            }
          }
        },
        {
          "name": "GET Buscar Restaurant por Nome",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants/search?name=Sabor",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "search"],
              "query": [{ "key": "name", "value": "Sabor" }]
            }
          }
        },
        {
          "name": "PUT Atualizar Restaurant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sabor do Brasil Premium\",\n  \"address\": \"Av. Paulista, 1000 - São Paulo/SP\",\n  \"kitchenType\": \"BRAZILIAN\",\n  \"openingHours\": \"Seg-Dom 11h-23h\",\n  \"restaurantOwnerId\": \"{{userId}}\"\n}"
            }
          }
        },
        {
          "name": "DELETE Remover Restaurant",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "MenuItem",
      "item": [
        {
          "name": "POST Criar MenuItem",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const id = pm.response.json().id;",
                  "  pm.collectionVariables.set('menuItemId', id);",
                  "  console.log('menuItemId salvo:', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/menu-items", "host": ["{{baseUrl}}"], "path": ["menu-items"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Feijoada Completa\",\n  \"description\": \"Feijoada tradicional com arroz, couve e laranja\",\n  \"price\": 49.90,\n  \"onlyInRestaurant\": true,\n  \"photoPath\": null,\n  \"restaurantId\": \"{{restaurantId}}\"\n}"
            }
          }
        },
        {
          "name": "GET Listar MenuItems",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/menu-items", "host": ["{{baseUrl}}"], "path": ["menu-items"] }
          }
        },
        {
          "name": "GET Buscar MenuItem por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu-items/{{menuItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu-items", "{{menuItemId}}"]
            }
          }
        },
        {
          "name": "GET Listar MenuItems por Restaurant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu-items/restaurant/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu-items", "restaurant", "{{restaurantId}}"]
            }
          }
        },
        {
          "name": "PUT Atualizar MenuItem",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/menu-items/{{menuItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu-items", "{{menuItemId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Feijoada Completa Especial\",\n  \"description\": \"Feijoada premium com farofa e torresmo\",\n  \"price\": 59.90,\n  \"onlyInRestaurant\": true,\n  \"photoPath\": \"/fotos/feijoada.jpg\",\n  \"restaurantId\": \"{{restaurantId}}\"\n}"
            }
          }
        },
        {
          "name": "DELETE Remover MenuItem",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/menu-items/{{menuItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu-items", "{{menuItemId}}"]
            }
          }
        }
      ]
    }
  ]
}
